@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mod:  <http://moddevices.com/ns/mod#> .

<http://cyber-audio.co.uk/plugins/cyber-fender-bassman59>
    a lv2:Plugin , lv2:SimulatorPlugin ;
    doap:name "Fender 5F6-A Tweed Bassman" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    rdfs:comment "Authentic analog circuit emulation of the 1959 Fender 5F6-A Tweed Bassman. Normal & Bright channels with parallel jumpering, cathode follower, tube rectifier sag, 4x10 Jensen P10R dynamic speaker stress, and zero-latency smart noise suppressor." ;
    mod:brand "Cyber Audio" ;
    mod:label "Tweed Bassman" ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Input" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Output" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "normal_vol" ;
        lv2:name "Normal Vol" ;
        lv2:default 1.6 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bright_vol" ;
        lv2:name "Bright Vol" ;
        lv2:default 1.6 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "channel_link" ;
        lv2:name "Channel Link / Jumper" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "bass" ;
        lv2:name "Bass" ;
        lv2:default 5.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "middle" ;
        lv2:name "Middle" ;
        lv2:default 7.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "treble" ;
        lv2:name "Treble" ;
        lv2:default 7.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "presence" ;
        lv2:name "Presence" ;
        lv2:default 7.4 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "speaker_cab" ;
        lv2:name "Speaker Cabinet" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "4x10 Jensen P10R Alnico Tweed (Stock)" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "2x12 Tweed Twin Jensen P12N" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Direct Out / Cab Bypass" ; rdf:value 2 ] ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "speaker_drive" ;
        lv2:name "Cone Stress / Drive" ;
        lv2:default 6.7 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "noise_gate" ;
        lv2:name "Zero Noise Suppressor" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ]     , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "output_level" ;
        lv2:name "Output Level" ;
        lv2:default 4.1 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        rdfs:comment "Master Output Volume / Attenuator (-24dB to +6dB). Allows cranking Master for power amp saturation without blasting downstream pedals." ;
    ] .
