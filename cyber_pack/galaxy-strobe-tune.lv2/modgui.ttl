@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://moddevices.com/plugins/danny/galaxy-strobe-tune>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-galaxy-strobe-tune.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "Strobe Tuner" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "black" ;
        modgui:knob "cyan" ;
        modgui:monitoredOutputs [ lv2:symbol "detected_freq" ] ,
                                [ lv2:symbol "cents_offset" ] ,
                                [ lv2:symbol "detected_note" ] ,
                                [ lv2:symbol "in_tune" ] ,
                                [ lv2:symbol "signal_level" ] ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "input_gain" ;
            lv2:name "Gain" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "stability" ;
            lv2:name "Stability" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "mute_mode" ;
            lv2:name "Mute" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "ref_a" ;
            lv2:name "Ref A" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "profile" ;
            lv2:name "Profile" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "capo" ;
            lv2:name "Capo" ;
        ] ;
    ] .
