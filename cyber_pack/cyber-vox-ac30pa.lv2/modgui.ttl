@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-vox-ac30pa>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-vox-ac30pa.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Vox AC30 PA" ;
        modgui:model "boxy" ;
        modgui:panel "1-select-1-knob" ;
        modgui:color "gold" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "ch1_vol" ;
            lv2:name "Ch 1 (Bright)" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "ch2_vol" ;
            lv2:name "Ch 2 (Norm)" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "ch3_vol" ;
            lv2:name "Ch 3 (Warm)" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "ch4_vol" ;
            lv2:name "Ch 4 (Lead)" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "tone" ;
            lv2:name "Tone" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "cut" ;
            lv2:name "Cut" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "speaker_drive" ;
            lv2:name "Cone Drive" ;
        ]
    ] .
