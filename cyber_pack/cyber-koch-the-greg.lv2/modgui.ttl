@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-koch-the-greg>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-koch-the-greg.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Koch The Greg" ;
        modgui:model "boxy" ;
        modgui:panel "1-select-1-knob" ;
        modgui:color "blue" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "gain" ;
            lv2:name "Gain" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "volume" ;
            lv2:name "Volume" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "ots_drive" ;
            lv2:name "OTS Drive" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "trem_speed" ;
            lv2:name "Speed" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "trem_depth" ;
            lv2:name "Depth" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "master" ;
            lv2:name "Master" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "speaker_drive" ;
            lv2:name "Cone Drive" ;
        ]
    ] .
