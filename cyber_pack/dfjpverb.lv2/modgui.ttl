@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://distrho.sf.net/plugins/DFJPverb>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Parker / DPF" ;
        modgui:label "DF JPverb" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#190a22" ;
        modgui:port 
        [
            lv2:index 0 ;
            lv2:symbol "t60" ;
            lv2:name "DECAY" ;
        ] ,
        [
            lv2:index 1 ;
            lv2:symbol "size" ;
            lv2:name "SIZE" ;
        ] ,
        [
            lv2:index 2 ;
            lv2:symbol "damp" ;
            lv2:name "DAMP" ;
        ] ,
        [
            lv2:index 3 ;
            lv2:symbol "early_diff" ;
            lv2:name "DIFFUSE" ;
        ] ,
        [
            lv2:index 4 ;
            lv2:symbol "low" ;
            lv2:name "LOW EQ" ;
        ] ,
        [
            lv2:index 5 ;
            lv2:symbol "mid" ;
            lv2:name "MID EQ" ;
        ] ,
        [
            lv2:index 6 ;
            lv2:symbol "high" ;
            lv2:name "HIGH EQ" ;
        ] ,
        [
            lv2:index 7 ;
            lv2:symbol "mod_depth" ;
            lv2:name "CHORUS" ;
        ] ,
        [
            lv2:index 8 ;
            lv2:symbol "dry" ;
            lv2:name "DRY LEVEL" ;
        ] ,
        [
            lv2:index 9 ;
            lv2:symbol "wet" ;
            lv2:name "WET LEVEL" ;
        ]
    ] .
