@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<http://distrho.sf.net/plugins/DFJPverb>
    a lv2:Plugin, lv2:ReverbPlugin ;
    doap:name "DF JPverb" ;
    doap:license <http://usefulinc.com/doap/licenses/gpl> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    rdfs:comment "Iconic algorithmic synth-wave & ambient algorithmic reverb engine based on Julian Parker and Till Bovermann's high-diffusion design." ;
    mod:brand "DISTHO / Parker" ;
    mod:label "DF JPverb" ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio In 1" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio In 2" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Out 1" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Out 2" ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "t60" ;
        lv2:name "Decay Time (T60)" ;
        lv2:default 2.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 60.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "size" ;
        lv2:name "Room Size" ;
        lv2:default 1.0 ;
        lv2:minimum 0.5 ;
        lv2:maximum 5.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "damp" ;
        lv2:name "Damping" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "early_diff" ;
        lv2:name "Early Diffusion" ;
        lv2:default 0.7071 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "low_cutoff" ;
        lv2:name "Low EQ Cutoff" ;
        lv2:default 300.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 1000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "high_cutoff" ;
        lv2:name "High EQ Cutoff" ;
        lv2:default 5000.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 20000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "low" ;
        lv2:name "Low Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "mid" ;
        lv2:name "Mid Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "high" ;
        lv2:name "High Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "mod_depth" ;
        lv2:name "Mod Depth" ;
        lv2:default 0.1 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "mod_freq" ;
        lv2:name "Mod Frequency" ;
        lv2:default 0.2 ;
        lv2:minimum 0.01 ;
        lv2:maximum 10.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "dry" ;
        lv2:name "Dry Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 16 ;
        lv2:symbol "wet" ;
        lv2:name "Wet Level" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] .
