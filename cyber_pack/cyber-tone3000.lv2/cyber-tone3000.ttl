@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<http://cyber-audio.co.uk/plugins/cyber-tone3000>
    a lv2:Plugin ,
      lv2:SimulatorPlugin ;
    doap:name "Cyber TONE3000" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "TONE3000" ;
    rdfs:comment "Official TONE3000 Cloud & NAM Neural Model Player with interactive signal chain blocks (Gate, NAM Neural, IR Cab/Acoustic Mic, 3-Band EQ) and full-screen cloud browser overlay." ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "input_gain" ;
        lv2:name "Input Gain" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "output_level" ;
        lv2:name "Output Level" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "gate" ;
        lv2:name "Noise Gate" ;
        lv2:default -80.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum -20.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "bass" ;
        lv2:name "Bass" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "mid" ;
        lv2:name "Middle" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "treble" ;
        lv2:name "Treble" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "model" ;
        lv2:name "NAM Model" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "Martin D-45 Studio Mic (Acoustic)"       ; rdf:value 0  ] ,
                        [ rdfs:label "Taylor 814ce Grand Auditorium"          ; rdf:value 1  ] ,
                        [ rdfs:label "Gibson J-45 Vintage Round Shoulder"     ; rdf:value 2  ] ,
                        [ rdfs:label "Guild F-512 12-String Acoustic"         ; rdf:value 3  ] ,
                        [ rdfs:label "Fender '65 Deluxe Reverb Blackface"     ; rdf:value 4  ] ,
                        [ rdfs:label "Fender '59 Tweed Bassman 4x10"          ; rdf:value 5  ] ,
                        [ rdfs:label "Dumble Overdrive Special (Clean)"        ; rdf:value 6  ] ,
                        [ rdfs:label "Matchless DC-30 Chime Channel"          ; rdf:value 7  ] ,
                        [ rdfs:label "Vox AC30 Top Boost 1964"                ; rdf:value 8  ] ,
                        [ rdfs:label "Marshall Bluesbreaker 1962 (JTM45)"     ; rdf:value 9  ] ,
                        [ rdfs:label "Orange Rockerverb 50 MkIII"              ; rdf:value 10 ] ,
                        [ rdfs:label "Marshall JCM800 2203 Classic 80s"       ; rdf:value 11 ] ,
                        [ rdfs:label "Soldano SLO-100 Super Lead Overdrive"    ; rdf:value 12 ] ,
                        [ rdfs:label "Mesa/Boogie Dual Rectifier Multi-Watt"  ; rdf:value 13 ] ,
                        [ rdfs:label "Ampeg SVT Classic 8x10 Tube Stack"      ; rdf:value 14 ] ,
                        [ rdfs:label "Darkglass Microtubes B7K Ultra"         ; rdf:value 15 ] ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "ir" ;
        lv2:name "Cab / Mic IR" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 13 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "Martin D-45 Studio Condenser (Neumann U87)" ; rdf:value 0  ] ,
                        [ rdfs:label "Taylor 814ce Ribbon Mic (Royer R-121)"     ; rdf:value 1  ] ,
                        [ rdfs:label "Gibson J-45 Vintage Dynamic (Shure SM7B)"  ; rdf:value 2  ] ,
                        [ rdfs:label "Guild 12-String Stereo Room Pair"          ; rdf:value 3  ] ,
                        [ rdfs:label "Fender Deluxe 1x12 Jensen C12N"            ; rdf:value 4  ] ,
                        [ rdfs:label "Fender Bassman 4x10 Jensen P10R"           ; rdf:value 5  ] ,
                        [ rdfs:label "Dumble 2x12 Electro-Voice EVM12L"          ; rdf:value 6  ] ,
                        [ rdfs:label "Vox AC30 2x12 Celestion Alnico Blue"       ; rdf:value 7  ] ,
                        [ rdfs:label "Marshall 1960A 4x12 Celestion V30"         ; rdf:value 8  ] ,
                        [ rdfs:label "Orange PPC412 4x12 Celestion V30"          ; rdf:value 9  ] ,
                        [ rdfs:label "Soldano 4x12 Eminence Legend X12"          ; rdf:value 10 ] ,
                        [ rdfs:label "Mesa Rectifier Oversized 4x12 V30"         ; rdf:value 11 ] ,
                        [ rdfs:label "Ampeg SVT-810E 8x10 Sealed Bass Cab"       ; rdf:value 12 ] ,
                        [ rdfs:label "Darkglass DG410N 4x10 Neodymium Bass"      ; rdf:value 13 ] ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "ir_blend" ;
        lv2:name "IR Blend" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] .
