@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-tone3000>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-tone3000.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "TONE 3000" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "black" ;
        modgui:knob "steel" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "input_gain" ;
            lv2:name "Gain" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "output_level" ;
            lv2:name "Volume" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "gate" ;
            lv2:name "Gate" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "bass" ;
            lv2:name "Bass" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "mid" ;
            lv2:name "Mid" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "treble" ;
            lv2:name "Treble" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "model" ;
            lv2:name "Model" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "ir" ;
            lv2:name "IR Cab" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "ir_blend" ;
            lv2:name "Blend" ;
        ] ;
    ] .
