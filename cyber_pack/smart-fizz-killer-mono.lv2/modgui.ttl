@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://moddevices.com/plugins/danny/smart-fizz-killer-mono>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-smart-fizz-killer.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "CyberAudio" ;
        modgui:label "Fizz Killer Mono" ;
        modgui:model "boxy" ;
        modgui:panel "11-knobs" ;
        modgui:color "copper" ;
        modgui:knob "copper" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "smear" ;
            lv2:name "Smear" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "fizz_freq" ;
            lv2:name "Fizz Freq" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "fizz_depth" ;
            lv2:name "Fizz Cut" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "fizz_sensitivity" ;
            lv2:name "Sens" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "saturation" ;
            lv2:name "Drive" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "symmetry" ;
            lv2:name "Symm" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "tilt" ;
            lv2:name "Tilt" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "body" ;
            lv2:name "Body" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "high_cut" ;
            lv2:name "Hi Cut" ;
        ] , [
            lv2:index 9 ;
            lv2:symbol "mix" ;
            lv2:name "Mix" ;
        ] , [
            lv2:index 10 ;
            lv2:symbol "output_level" ;
            lv2:name "Level" ;
        ] ;
    ] .
