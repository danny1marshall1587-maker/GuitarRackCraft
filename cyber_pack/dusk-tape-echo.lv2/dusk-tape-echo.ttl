@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<http://dusk-audio.com/plugins/tape-echo-2>
    a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "Dusk Tape Echo 2" ;
    doap:license <http://usefulinc.com/doap/licenses/gpl> ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    rdfs:comment "Iconic three-head vintage tape echo with spring reverb tank, authentic flux saturation, and wow/flutter tape-age modulation (inspired by the Roland RE-201 Space Echo)." ;
    mod:brand "Dusk Audio" ;
    mod:label "Tape Echo 2" ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "mode" ;
        lv2:name "Head Mode" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 5 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Head 1 (Fast)" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Head 2 (Mid)" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Head 3 (Long)" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Heads 1 + 2" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Heads 2 + 3" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Heads 1 + 2 + 3" ; rdf:value 5 ] ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "rate" ;
        lv2:name "Repeat Rate" ;
        lv2:default 300.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 800.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "intensity" ;
        lv2:name "Intensity" ;
        lv2:default 0.6 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.2 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "age" ;
        lv2:name "Tape Age" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "spring" ;
        lv2:name "Spring Reverb" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "echo_vol" ;
        lv2:name "Echo Volume" ;
        lv2:default 0.8 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "dry_vol" ;
        lv2:name "Dry Volume" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] .
