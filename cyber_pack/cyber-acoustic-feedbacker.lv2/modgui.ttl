@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://cyber-audio.co.uk/plugins/cyber-acoustic-feedbacker>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-acoustic-feedbacker.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Feedbacker" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#78350f" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "trigger" ;
            lv2:name "Feedback Trigger" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "mode" ;
            lv2:name "Mode" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "bloom" ;
            lv2:name "Bloom Time" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "gain" ;
            lv2:name "Feedback Gain" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "harmonic" ;
            lv2:name "Harmonic Mode" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "warmth" ;
            lv2:name "Warmth" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "vibrato" ;
            lv2:name "Vibrato Track" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "mix" ;
            lv2:name "Mix" ;
        ] ;
    ] .
