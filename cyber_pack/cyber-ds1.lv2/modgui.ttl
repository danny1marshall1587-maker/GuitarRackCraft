@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://cyber-audio.co.uk/plugins/cyber-ds1>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-ds1.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Cyber DS-1" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#d44a00" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "dist" ;
            lv2:name "Dist" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "tone" ;
            lv2:name "Tone" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "level" ;
            lv2:name "Level" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "bias" ;
            lv2:name "Bias" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "sens" ;
            lv2:name "Sens" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "sparkle" ;
            lv2:name "Sparkle" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "ultra_mod" ;
            lv2:name "Ultra Mod" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "mix" ;
            lv2:name "Mix" ;
        ] ;
    ] .
