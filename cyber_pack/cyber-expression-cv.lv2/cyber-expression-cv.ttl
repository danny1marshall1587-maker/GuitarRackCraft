@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<http://moddevices.com/plugins/danny/cyber-expression-cv>
    a lv2:Plugin ,
      mod:ControlVoltagePlugin ;
    doap:name "Cyber Expression (MIDI CC to CV Controller)" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "Expression CV" ;
    rdfs:comment "Converts MIDI Expression Pedal (CC #07 / CC #11) into 4 simultaneous Control Voltage (CV) outputs with customizable smoothing, min/max range, and response curves to control multiple pedals simultaneously." ;

    lv2:port [
        a lv2:InputPort ,
          atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort ,
          lv2:CVPort ,
          mod:CVPort ;
        lv2:index 1 ;
        lv2:symbol "cv_out1" ;
        lv2:name "CV Out 1 (Direct)" ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:OutputPort ,
          lv2:CVPort ,
          mod:CVPort ;
        lv2:index 2 ;
        lv2:symbol "cv_out2" ;
        lv2:name "CV Out 2 (Inverted)" ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:OutputPort ,
          lv2:CVPort ,
          mod:CVPort ;
        lv2:index 3 ;
        lv2:symbol "cv_out3" ;
        lv2:name "CV Out 3 (0-1V Norm)" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:OutputPort ,
          lv2:CVPort ,
          mod:CVPort ;
        lv2:index 4 ;
        lv2:symbol "cv_out4" ;
        lv2:name "CV Out 4 (Bipolar)" ;
        lv2:minimum -5.0 ;
        lv2:maximum 5.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "cc_number" ;
        lv2:name "MIDI CC #" ;
        lv2:default 7 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "midi_channel" ;
        lv2:name "MIDI Channel" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Omni (All Channels)" ; rdf:value 0 ] ,
                       [ rdfs:label "Channel 1" ; rdf:value 1 ] ,
                       [ rdfs:label "Channel 2" ; rdf:value 2 ] ,
                       [ rdfs:label "Channel 3" ; rdf:value 3 ] ,
                       [ rdfs:label "Channel 4" ; rdf:value 4 ] ,
                       [ rdfs:label "Channel 5" ; rdf:value 5 ] ,
                       [ rdfs:label "Channel 6" ; rdf:value 6 ] ,
                       [ rdfs:label "Channel 7" ; rdf:value 7 ] ,
                       [ rdfs:label "Channel 8" ; rdf:value 8 ] ,
                       [ rdfs:label "Channel 9" ; rdf:value 9 ] ,
                       [ rdfs:label "Channel 10" ; rdf:value 10 ] ,
                       [ rdfs:label "Channel 11" ; rdf:value 11 ] ,
                       [ rdfs:label "Channel 12" ; rdf:value 12 ] ,
                       [ rdfs:label "Channel 13" ; rdf:value 13 ] ,
                       [ rdfs:label "Channel 14" ; rdf:value 14 ] ,
                       [ rdfs:label "Channel 15" ; rdf:value 15 ] ,
                       [ rdfs:label "Channel 16" ; rdf:value 16 ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "smoothing" ;
        lv2:name "Smoothing" ;
        lv2:default 15.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "min_val" ;
        lv2:name "Min Voltage" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        units:unit mod:volts ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "max_val" ;
        lv2:name "Max Voltage" ;
        lv2:default 10.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        units:unit mod:volts ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "curve" ;
        lv2:name "Taper Curve" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Linear" ; rdf:value 0 ] ,
                       [ rdfs:label "Logarithmic (Audio)" ; rdf:value 1 ] ,
                       [ rdfs:label "Anti-Log (Reverse Audio)" ; rdf:value 2 ] ,
                       [ rdfs:label "S-Curve (Smoothstep)" ; rdf:value 3 ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "manual_pos" ;
        lv2:name "Manual Override" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] .
