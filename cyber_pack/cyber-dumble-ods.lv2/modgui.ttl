@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-dumble-ods>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-dumble-ods.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Dumble ODS" ;
        modgui:model "boxy" ;
        modgui:panel "1-select-1-knob" ;
        modgui:color "black" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "clean_vol" ;
            lv2:name "Volume" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "clean_treble" ;
            lv2:name "Treble" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "clean_mid" ;
            lv2:name "Middle" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "clean_bass" ;
            lv2:name "Bass" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "od_drive" ;
            lv2:name "OD Ratio" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "od_level" ;
            lv2:name "OD Level" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "master" ;
            lv2:name "Master" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "presence" ;
            lv2:name "Presence" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "speaker_drive" ;
            lv2:name "Cone Drive" ;
        ]
    ] .
