@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<http://moddevices.com/plugins/danny/mains-hum-killer>
    a lv2:Plugin ,
      lv2:UtilityPlugin ;
    doap:name "Cyber Hum Killer (Mains Hum & Buzz Suppressor)" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "Hum Killer" ;
    rdfs:comment "Eliminates single-coil electric guitar 50Hz/60Hz mains hum, ground loops, and lighting buzz using an ultra-narrow 16-stage harmonic notch array without coloring your guitar tone." ;

    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "grid_freq" ;
        lv2:name "Mains Frequency" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [
            rdfs:label "50 Hz (UK / Europe)" ;
            rdf:value 0
        ] , [
            rdfs:label "60 Hz (US / Americas)" ;
            rdf:value 1
        ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "depth" ;
        lv2:name "Hum Cut Depth" ;
        lv2:default -40.0 ;
        lv2:minimum -60.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "harmonics" ;
        lv2:name "Harmonics Count" ;
        lv2:default 10 ;
        lv2:minimum 1 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "buzz_kill" ;
        lv2:name "HF Buzz Suppress" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "q_width" ;
        lv2:name "Notch Q / Sharpness" ;
        lv2:default 45.0 ;
        lv2:minimum 15.0 ;
        lv2:maximum 80.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "fine_tune" ;
        lv2:name "Grid Fine Tune" ;
        lv2:default 0.0 ;
        lv2:minimum -3.0 ;
        lv2:maximum 3.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "listen_mode" ;
        lv2:name "Audition Hum Only" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ] .
