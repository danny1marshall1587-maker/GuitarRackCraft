@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-bass9>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate        <modgui/icon-cyber-bass9.html> ;
        modgui:stylesheet          <modgui/stylesheet.css> ;
        modgui:javascript          <modgui/script.js> ;
        modgui:screenshot          <modgui/screenshot.png> ;
        modgui:thumbnail           <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "Evans Bass" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "black" ;
        modgui:knob "black" ;

        modgui:port [
            lv2:index  0 ; lv2:symbol "third_mode" ;
        ] , 
        [
            lv2:index  1 ; lv2:symbol "ns_sub_oct" ;
        ] , 
        [
            lv2:index  2 ; lv2:symbol "ns_sub_fifth" ;
        ] , 
        [
            lv2:index  3 ; lv2:symbol "ns_sub_third" ;
        ] , 
        [
            lv2:index  4 ; lv2:symbol "ns_root" ;
        ] , 
        [
            lv2:index  5 ; lv2:symbol "ns_third" ;
        ] , 
        [
            lv2:index  6 ; lv2:symbol "ns_fifth" ;
        ] , 
        [
