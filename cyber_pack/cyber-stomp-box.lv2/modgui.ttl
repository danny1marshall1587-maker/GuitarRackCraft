@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://moddevices.com/plugins/danny/cyber-stomp-box>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-stomp-box.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "CyberStomp" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#3b1e08" ;
        modgui:monitoredOutputs [ lv2:symbol "led_activity" ] ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "trigger" ;
            lv2:name "Stomp" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "model" ;
            lv2:name "Sound" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "pitch" ;
            lv2:name "Tune" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "decay" ;
            lv2:name "Decay" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "punch" ;
            lv2:name "Punch" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "sub_thump" ;
            lv2:name "Sub Thump" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "tone" ;
            lv2:name "Tone" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "fixed_vel" ;
            lv2:name "Fixed Vel" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "guitar_vol" ;
            lv2:name "Guitar Vol" ;
        ] , [
            lv2:index 9 ;
            lv2:symbol "stomp_vol" ;
            lv2:name "Stomp Vol" ;
        ] , [
            lv2:index 10 ;
            lv2:symbol "output_mode" ;
            lv2:name "Routing" ;
        ]
    ] .
