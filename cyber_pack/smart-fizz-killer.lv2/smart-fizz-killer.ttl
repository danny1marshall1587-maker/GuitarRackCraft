@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<http://moddevices.com/plugins/danny/smart-fizz-killer>
    a lv2:Plugin ,
      lv2:UtilityPlugin ;
    doap:name "Smart Fizz Killer" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "Fizz Killer" ;
    rdfs:comment "4-stage digital guitar smoothing processor. Phase smear softens transients, dynamic fizz cut clamps harsh spikes, tanh soft-clipper rounds digital peaks, and tilt EQ adds warmth and body. Place at the end of your pedalboard to smooth out harsh NAM profiles and digital effects." ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In Left" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In Right" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out Left" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out Right" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "smear" ;
        lv2:name "Phase Smear" ;
        lv2:default 2500.0 ;
        lv2:minimum 800.0 ;
        lv2:maximum 6000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "fizz_freq" ;
        lv2:name "Fizz Frequency" ;
        lv2:default 5500.0 ;
        lv2:minimum 3000.0 ;
        lv2:maximum 8000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "fizz_depth" ;
        lv2:name "Fizz Depth" ;
        lv2:default 6.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 18.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "fizz_sensitivity" ;
        lv2:name "Fizz Sensitivity" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "saturation" ;
        lv2:name "Saturation" ;
        lv2:default 25.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "symmetry" ;
        lv2:name "Symmetry" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "tilt" ;
        lv2:name "Tilt" ;
        lv2:default -30.0 ;
        lv2:minimum -100.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "body" ;
        lv2:name "Body" ;
        lv2:default 3.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 12.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "high_cut" ;
        lv2:name "High Cut" ;
        lv2:default 9000.0 ;
        lv2:minimum 4000.0 ;
        lv2:maximum 16000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "output_level" ;
        lv2:name "Output" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 6.0 ;
        units:unit units:db ;
    ] .
