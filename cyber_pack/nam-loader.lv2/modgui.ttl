@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://moddevices.com/plugins/danny/nam-loader>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-nam-loader.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "NAM Loader" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "black" ;
        modgui:knob "bronze" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "profile" ;
            lv2:name "Model" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "drive" ;
            lv2:name "Gain" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "bass" ;
            lv2:name "Bass" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "mid" ;
            lv2:name "Mid" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "treble" ;
            lv2:name "Treble" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "volume" ;
            lv2:name "Master" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "gate" ;
            lv2:name "Gate" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "cab_enable" ;
            lv2:name "Cab" ;
        ] ;
    ] .
