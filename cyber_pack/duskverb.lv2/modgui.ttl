@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://dusk-audio.com/plugins/duskverb>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Dusk Audio" ;
        modgui:label "DuskVerb" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#0a182e" ;
        modgui:port 
        [
            lv2:index 0 ;
            lv2:symbol "algorithm" ;
            lv2:name "ALGO (0-4)" ;
        ] ,
        [
            lv2:index 1 ;
            lv2:symbol "decay" ;
            lv2:name "DECAY" ;
        ] ,
        [
            lv2:index 2 ;
            lv2:symbol "predelay" ;
            lv2:name "PRE-DELAY" ;
        ] ,
        [
            lv2:index 3 ;
            lv2:symbol "damping" ;
            lv2:name "DAMPING" ;
        ] ,
        [
            lv2:index 4 ;
            lv2:symbol "width" ;
            lv2:name "WIDTH" ;
        ] ,
        [
            lv2:index 5 ;
            lv2:symbol "mix" ;
            lv2:name "MIX" ;
        ]
    ] .
