@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<http://dusk-audio.com/plugins/duskverb>
    a lv2:Plugin, lv2:ReverbPlugin ;
    doap:name "DuskVerb" ;
    doap:license <http://usefulinc.com/doap/licenses/gpl> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    rdfs:comment "Modern 5-in-1 Algorithmic Reverb featuring 16-channel Feedback Delay Network & Dattorro diffusion stages (Plate, Hall, Chamber, Room, Ambient)." ;
    mod:brand "Dusk Audio" ;
    mod:label "DuskVerb" ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio In 1" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio In 2" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Out 1" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Out 2" ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "algorithm" ;
        lv2:name "Algorithm" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:enumeration, lv2:integer ;
        lv2:scalePoint [ rdfs:label "Plate" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Hall" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Chamber" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Room" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Ambient" ; rdf:value 4 ] ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "decay" ;
        lv2:name "Decay Time" ;
        lv2:default 3.0 ;
        lv2:minimum 0.2 ;
        lv2:maximum 30.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "predelay" ;
        lv2:name "Pre-Delay" ;
        lv2:default 20.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 250.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "damping" ;
        lv2:name "High Damping" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "width" ;
        lv2:name "Stereo Width" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 200.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] .
