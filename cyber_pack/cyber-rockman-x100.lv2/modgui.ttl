@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-rockman-x100>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-rockman-x100.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Rockman X100" ;
        modgui:model "boxy" ;
        modgui:panel "1-select-1-knob" ;
        modgui:color "blue" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "mode" ;
            lv2:name "Mode" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "volume" ;
            lv2:name "Volume" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "chorus_depth" ;
            lv2:name "Chorus" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "speaker_drive" ;
            lv2:name "Cone Drive" ;
        ]
    ] .
