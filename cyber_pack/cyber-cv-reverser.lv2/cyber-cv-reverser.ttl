@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<http://cyberaudio.com/plugins/cyber-cv-reverser>
    a lv2:Plugin , mod:ControlVoltagePlugin ;
    doap:name "Cyber CV Reverser" ;
    doap:developer [
        doap:name "CyberAudio" ;
    ] ;
    lv2:microVersion 0 ;
    lv2:minorVersion 1 ;
    mod:brand "CyberAudio" ;
    mod:label "CV Reverser" ;
    rdfs:comment "Takes any 0-10V CV input (e.g. from Control to CV) and outputs an inverted Reverse CV signal (10-0V) with custom Min/Max scaling and smoothing." ;

    lv2:port [
        a lv2:InputPort , lv2:CVPort , mod:CVPort ;
        lv2:index 0 ;
        lv2:symbol "cv_in" ;
        lv2:name "CV Input" ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        units:unit mod:volts ;
    ] , [
        a lv2:OutputPort , lv2:CVPort , mod:CVPort ;
        lv2:index 1 ;
        lv2:symbol "cv_out_rev" ;
        lv2:name "CV Reverse" ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        units:unit mod:volts ;
    ] , [
        a lv2:OutputPort , lv2:CVPort , mod:CVPort ;
        lv2:index 2 ;
        lv2:symbol "cv_out_thru" ;
        lv2:name "CV Thru (Normal)" ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        units:unit mod:volts ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "min_val" ;
        lv2:name "Min Output %" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "max_val" ;
        lv2:name "Max Output %" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "smoothing" ;
        lv2:name "Smoothing" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] .
