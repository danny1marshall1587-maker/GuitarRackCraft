@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://cyber-audio.co.uk/plugins/cyber-noble-drive>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-noble-drive.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Noble Drive" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#1e331b" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "drive" ;
            lv2:name "Drive" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "spectrum" ;
            lv2:name "Spectrum" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "presence" ;
            lv2:name "Presence" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "volume" ;
            lv2:name "Volume" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "bias" ;
            lv2:name "Bias" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "sens" ;
            lv2:name "Sens" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "sparkle" ;
            lv2:name "Sparkle" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "bass_cut" ;
            lv2:name "Bass Cut" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "mix" ;
            lv2:name "Mix" ;
        ] ;
    ] .
