@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<http://cyberaudio.com/plugins/cyber-piezo-thump-killer>
    a lv2:Plugin , lv2:EQPlugin ;
    doap:name "Cyber Piezo Thump Killer" ;
    doap:developer [
        doap:name "CyberAudio" ;
    ] ;
    lv2:microVersion 0 ;
    lv2:minorVersion 3 ;
    mod:brand "CyberAudio" ;
    mod:label "Thump Killer" ;
    rdfs:comment "Acoustic guitar piezo processor with dual dynamic notch filters, harmonic tracking (75% to 2nd harmonic, 25% to 3rd harmonic), and zero-latency soft-knee spike clamp to eliminate heavy palm thump, shockwaves, and soundbox mud while keeping your natural acoustic dynamics intact." ;

    lv2:port [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "hpf_freq" ;
        lv2:name "Rumble Cut" ;
        lv2:default 40.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 100.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "thump_freq" ;
        lv2:name "Thump Freq" ;
        lv2:default 95.0 ;
        lv2:minimum 60.0 ;
        lv2:maximum 180.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "thump_sens" ;
        lv2:name "Thump Sens" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "thump_depth" ;
        lv2:name "Thump Depth" ;
        lv2:default 14.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "mud_freq" ;
        lv2:name "Mud Freq" ;
        lv2:default 220.0 ;
        lv2:minimum 150.0 ;
        lv2:maximum 400.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "mud_sens" ;
        lv2:name "Mud Sens" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "mud_depth" ;
        lv2:name "Mud Depth" ;
        lv2:default 10.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 18.0 ;
        units:unit units:db ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "harmonics" ;
        lv2:name "Harmonics" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "peak_clamp" ;
        lv2:name "Spike Clamp" ;
        lv2:default -4.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "listen" ;
        lv2:name "Listen Mode" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [
            rdf:value 0.0 ;
            rdfs:label "Normal" ;
        ] , [
            rdf:value 1.0 ;
            rdfs:label "Listen Thump" ;
        ] , [
            rdf:value 2.0 ;
            rdfs:label "Listen Mud" ;
        ] ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "out_gain" ;
        lv2:name "Output Level" ;
        lv2:default 0.0 ;
        lv2:minimum -12.0 ;
        lv2:maximum 6.0 ;
        units:unit units:db ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "thump_gr" ;
        lv2:name "Thump Reduction" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 24.0 ;
        units:unit units:db ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "mud_gr" ;
        lv2:name "Mud Reduction" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 18.0 ;
        units:unit units:db ;
    ] .
