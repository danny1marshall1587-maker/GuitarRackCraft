@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://cyber-audio.co.uk/plugins/cyber-klon>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-klon.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Cyber Klon" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#b89738" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "gain" ;
            lv2:name "Gain" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "treble" ;
            lv2:name "Treble" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "output" ;
            lv2:name "Output" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "bias" ;
            lv2:name "Bias" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "sens" ;
            lv2:name "Sens" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "sparkle" ;
            lv2:name "Sparkle" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "magic_mod" ;
            lv2:name "Magic Mod" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "mix" ;
            lv2:name "Mix" ;
        ] ;
    ] .
