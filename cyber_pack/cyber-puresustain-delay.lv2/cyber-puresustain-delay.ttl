@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix epp: <http://lv2plug.in/ns/ext/port-props#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<http://cyber-audio.co.uk/plugins/cyber-puresustain-delay>
    a lv2:Plugin ,
      lv2:DelayPlugin ;
    doap:name "Cyber PureSustain Delay" ;
    doap:license <http://opensource.org/licenses/mit> ;
    doap:developer [
        foaf:name "Cyber Audio" ;
        foaf:homepage <http://cyber-audio.co.uk> ;
    ] ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    mod:brand "Cyber Audio" ;
    mod:label "PureSustain" ;
    rdfs:comment "Boutique Seamless Crossfade Pad Delay with quadrature stereo modulation, Cytomic SVF tail filtering, Hermite interpolation, and dynamic picking ducker." ;

    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "time" ;
        lv2:name "Time" ;
        lv2:default 400.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 45.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 110.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "melt" ;
        lv2:name "Melt" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Seamless loop crossfade width: 0% = crisp rhythmic taps, 100% = infinite smooth pad sustain." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "tone" ;
        lv2:name "Tone" ;
        lv2:default 70.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Non-dispersive 1-pole gentle analog tape high-frequency damping." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "duck" ;
        lv2:name "Duck" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Dynamic sidechain ducker: ducks wet pad during active picking." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "mod_on" ;
        lv2:name "Mod On" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        rdfs:comment "Engage quadrature stereo LFO delay modulation." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "mod_depth" ;
        lv2:name "Mod Depth" ;
        lv2:default 25.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
        rdfs:comment "Modulation depth / width." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "mod_rate" ;
        lv2:name "Mod Rate" ;
        lv2:default 0.8 ;
        lv2:minimum 0.1 ;
        lv2:maximum 5.0 ;
        units:unit units:hz ;
        rdfs:comment "Modulation LFO rate / frequency." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "hp_freq" ;
        lv2:name "Low Cut" ;
        lv2:default 80.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:hz ;
        lv2:portProperty epp:logarithmic ;
        rdfs:comment "High-pass filter cutoff in delay feedback tail (Low Cut)." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "lp_freq" ;
        lv2:name "High Cut" ;
        lv2:default 6500.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 20000.0 ;
        units:unit units:hz ;
        lv2:portProperty epp:logarithmic ;
        rdfs:comment "Low-pass filter cutoff in delay feedback tail (High Cut)." ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 16 ;
        lv2:symbol "filter_q" ;
        lv2:name "Filter Shape" ;
        lv2:default 0.707 ;
        lv2:minimum 0.5 ;
        lv2:maximum 4.0 ;
        rdfs:comment "Resonance / Q shape for tail high-pass and low-pass filters." ;
    ] .
