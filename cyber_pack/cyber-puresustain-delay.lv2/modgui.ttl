@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://cyber-audio.co.uk/plugins/cyber-puresustain-delay>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-puresustain-delay.html> ;
        modgui:stylesheet <modgui/stylesheet-cyber-puresustain-delay.css> ;
        modgui:screenshot <modgui/screenshot-cyber-puresustain-delay.png> ;
        modgui:thumbnail <modgui/thumbnail-cyber-puresustain-delay.png> ;
        modgui:brand "CYBER AUDIO" ;
        modgui:label "PureSustain" ;
        modgui:model "boxy" ;
        modgui:panel "12-knobs" ;
        modgui:color "purple" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "time" ;
            lv2:name "TIME" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "feedback" ;
            lv2:name "REPEAT" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "melt" ;
            lv2:name "MELT" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "mix" ;
            lv2:name "MIX" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "hp_freq" ;
            lv2:name "LOW CUT" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "lp_freq" ;
            lv2:name "HIGH CUT" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "filter_q" ;
            lv2:name "SHAPE" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "tone" ;
            lv2:name "TONE" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "mod_rate" ;
            lv2:name "RATE" ;
        ] , [
            lv2:index 9 ;
            lv2:symbol "mod_depth" ;
            lv2:name "DEPTH" ;
        ] , [
            lv2:index 10 ;
            lv2:symbol "duck" ;
            lv2:name "DUCK" ;
        ] , [
            lv2:index 11 ;
            lv2:symbol "mod_on" ;
            lv2:name "MOD ON" ;
        ] ;
    ] .
