@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://invadarecords.com/plugins/lv2/delay/mono>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Invada Studio" ;
        modgui:label "Delay Munge" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#141416" ;
        modgui:port 
        [
            lv2:index 0 ;
            lv2:symbol "delay1" ;
            lv2:name "TIME 1" ;
        ] ,
        [
            lv2:index 1 ;
            lv2:symbol "fb1" ;
            lv2:name "FEEDBK 1" ;
        ] ,
        [
            lv2:index 2 ;
            lv2:symbol "vol1" ;
            lv2:name "LEVEL 1" ;
        ] ,
        [
            lv2:index 3 ;
            lv2:symbol "delay2" ;
            lv2:name "TIME 2" ;
        ] ,
        [
            lv2:index 4 ;
            lv2:symbol "fb2" ;
            lv2:name "FEEDBK 2" ;
        ] ,
        [
            lv2:index 5 ;
            lv2:symbol "vol2" ;
            lv2:name "LEVEL 2" ;
        ] ,
        [
            lv2:index 6 ;
            lv2:symbol "munge" ;
            lv2:name "MUNGE" ;
        ] ,
        [
            lv2:index 7 ;
            lv2:symbol "LFOcycle" ;
            lv2:name "LFO RATE" ;
        ] ,
        [
            lv2:index 8 ;
            lv2:symbol "LFOdepth" ;
            lv2:name "DEPTH" ;
        ]
    ] .
