@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-toneking-imperial>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-toneking-imperial.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Tone King" ;
        modgui:model "boxy" ;
        modgui:panel "1-select-1-knob" ;
        modgui:color "blue" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "rhythm_vol" ;
            lv2:name "Rhy Vol" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "rhythm_treble" ;
            lv2:name "Treble" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "rhythm_bass" ;
            lv2:name "Bass" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "mid_bite" ;
            lv2:name "Mid-Bite" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "lead_vol" ;
            lv2:name "Lead Vol" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "lead_tone" ;
            lv2:name "Lead Tone" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "speaker_drive" ;
            lv2:name "Cone Drive" ;
        ]
    ] .
